{
  "rules": {
    "licenses": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": false,
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $deviceId",
        "$other": {
          ".validate": false
        }
      }
    },
    "health_check": {
      ".read": true,
      ".write": false
    },
    "serverTime": {
      ".read": true,
      ".write": "auth != null && auth.token.admin == true"
    }
  }
}
