{
  "rules": {
    "licenses": {
      "$licenseId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.admin == true"
      }
    },
    "payment_history": {
      "$licenseId": {
        ".read": "auth != null",
        ".write": false
      }
    },
    "health_check": { ".read": true, ".write": false },
    "serverTime": { ".read": true, ".write": "auth != null && auth.token.admin == true" }
  }
}
