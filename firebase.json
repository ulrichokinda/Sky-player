{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "site": "skyplayerapp",
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],    "rewrites": [
      {"source": "/admin", "destination": "/admin/index.html"},
      {"source": "/api/check-status", "function": "checkPaymentStatus"},
      {"source": "/api/update-status", "function": "updateLicenseStatus"},
      {"source": "**", "destination": "/index.html"}
    ],
    "headers": [
      { "source": "/api/**", "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://skyplayerapp.xyz" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, X-Activation-API-Key, X-API-Key" }
      ]}
    ]
  },
  "functions": [{ "source": "firebase-functions", "codebase": "sky-player-api", "runtime": "nodejs20" }]
}
