rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════
    // DEFAULT: deny-all (all access via Cloud Functions Admin SDK)
    // ═══════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ═══════════════════════════════════════════════════════════════
    // B11: ADMIN DASHBOARD — allow authenticated admin users
    // ═══════════════════════════════════════════════════════════════
    match /activations/{docId} {
      allow read: if request.auth != null && isAdmin();
      allow write: if request.auth != null && isAdmin();
    }

    match /payments/{docId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /metrics/{docId} {
      allow read: if request.auth != null && isAdmin();
    }

    match /resellers/{docId} {
      allow read, write: if request.auth != null && isAdmin();
    }

    match /fcm_tokens/{docId} {
      allow read, write: if false; // Only via Cloud Functions
    }

    match /rate_limits/{docId} {
      allow read, write: if false; // Only via Cloud Functions
    }

    // Helper function: check if user is admin
    function isAdmin() {
      return request.auth.token.admin == true
          || request.auth.token.role == 'admin';
    }
  }
}
